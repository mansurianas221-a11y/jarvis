# ---------------------------------------------------------------------------
# Jarvis — environment configuration
# Copy this file to `.env` and fill in what you have.
# NEVER commit a real `.env` file, and NEVER hardcode keys in the app source.
# ---------------------------------------------------------------------------

# Base URL of the AI API routes deployed from the `server/` folder.
# Examples:
#   local dev     ->  http://192.168.1.20:8787
#   Vercel        ->  https://jarvis-yourname.vercel.app
# Leave EMPTY to run the app in offline "Demo Mode" (canned local responses).
EXPO_PUBLIC_API_BASE_URL=

# Optional shared secret. If set, it must match AI_ROUTE_SECRET on the server.
EXPO_PUBLIC_APP_SECRET=

# Public flags used by the client UI.
EXPO_PUBLIC_ENABLE_WAKE_WORD=true
EXPO_PUBLIC_DEMO_MODE_ALLOWED=true
